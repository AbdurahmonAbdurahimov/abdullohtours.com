{
  "name": "abdullohtours-static",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CLI build for abdullohtours.com (no cdn.tailwindcss.com — CLAUDE.md §2).",
  "scripts": {
    "build:css": "tailwindcss -c static_src/tailwind.config.js -i static_src/input.css -o static/css/main.css --minify",
    "watch:css": "tailwindcss -c static_src/tailwind.config.js -i static_src/input.css -o static/css/main.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}

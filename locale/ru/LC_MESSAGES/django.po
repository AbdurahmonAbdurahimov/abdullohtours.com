#. Translators: %(a)s and %(b)s are destination names, e.g. "Samarkand"
#. and "Bukhara" — resolved per-language via modeltranslation already,
#. so only the surrounding phrase needs translating here.
#, python-format
msgid "%(a)s & %(b)s Tour"
msgstr "Тур: %(a)s и %(b)s"

msgid "Blog"
msgstr "Блог"

msgid "Request a Quote"
msgstr "Оставить заявку"

msgid "Request a quote"
msgstr "Оставить заявку"

msgid "Send Request"
msgstr "Отправить заявку"

msgid "Prefer to chat?"
msgstr "Удобнее в чате?"

msgid "Message us directly and we'll reply just as fast."
msgstr "Напишите нам напрямую — ответим так же быстро."

msgid "Telegram"
msgstr "Telegram"

msgid "Request received"
msgstr "Заявка получена"

msgid "Thank you!"
msgstr "Спасибо!"


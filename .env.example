# Copy to .env and fill in real values. Never commit the real .env.

# --- Django ---
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Canonical host (CLAUDE.md deployment target: no www) ---
CANONICAL_HOST=https://abdullohtours.com

# --- PostgreSQL ---
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Telegram bot (CLAUDE.md §8) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-secret-path-segment

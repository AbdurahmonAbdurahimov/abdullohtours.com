# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/

# Django
# Generated Tailwind output — STATICFILES_DIRS is static_src/, so this is
# where `npm run build:css` writes (see package.json), not a top-level
# /static/ (that would be invisible to collectstatic and to runserver's
# dev static-file finder).
/static_src/css/
/media/
staticfiles/
*.sqlite3
db.sqlite3
db_backups/

# Compiled gettext catalogs — .po sources are committed, .mo is generated by
# `manage.py compilemessages` (run in the Dockerfile at build time, same as
# the Tailwind CSS build) so it's never stale relative to the .po it came from.
*.mo

# Env / secrets
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Claude Code local settings (machine/session-specific, not project config)
.claude/settings.local.json

# Docker
*.log
